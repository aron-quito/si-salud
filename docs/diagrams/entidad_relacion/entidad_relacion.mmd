erDiagram
    USUARIO {
        int id PK
        string email
        string password
        string rol "Paciente, Medico, Admision, Admin"
        string estado "Activo, Inactivo"
    }
    PACIENTE {
        int id PK
        int usuario_id FK "Null si es dependiente sin email"
        string dni
        string nombres
        string apellidos
        date fecha_nacimiento
        string telefono
        boolean es_titular
        int contador_faltas "Inasistencias acumuladas"
        boolean permite_agendar "Penalizacion por abuso"
        datetime penalizado_hasta
    }
    CARGA_FAMILIAR {
        int id PK
        int usuario_titular_id FK
        int paciente_id FK
        string parentesco "Hijo/a, Conyuge, Padre/Madre, Tutorado"
        datetime fecha_vinculacion
    }
    MEDICO {
        int id PK
        int usuario_id FK
        string cmp
        string nombres
        string apellidos
        string jerarquia
    }
    SEDE {
        int id PK
        string nombre
        string direccion
        boolean activa
    }
    CONSULTORIO {
        int id PK
        int sede_id FK
        string numero_nombre
        boolean activo
    }
    ESPECIALIDAD {
        int id PK
        string nombre
        string descripcion
        boolean activa
    }
    MEDICO_ESPECIALIDAD {
        int medico_id FK
        int especialidad_id FK
    }
    TIPO_CONSULTA {
        int id PK
        string nombre
        int duracion_base_minutos
        boolean activo
    }
    ASEGURADORA {
        int id PK
        string nombre "SIS, EsSalud, Particular"
        string tipo
        boolean activa
    }
    BLOQUE_HORARIO {
        int id PK
        int medico_id FK
        int consultorio_id FK
        date fecha
        time hora_inicio
        time hora_fin
        string estado "Libre, Hold_Temporal, Ocupado, Bloqueado"
        datetime hold_expira_at
        int hold_paciente_id
    }
    SOLICITUD_TRIAJE {
        int id PK
        int paciente_id FK
        int especialidad_id FK
        text sintomas
        string especialidad_sugerida
        string preferencia_horario "Manana, Tarde"
        int score_urgencia
        string modalidad "Presencial, Meet, Llamada"
        boolean es_reprogramacion
        boolean derivado_urgencia
        boolean requiere_interconsulta
        string estado "Pendiente, Agendado, Derivado_Urgencias, Cancelado"
    }
    LISTA_ESPERA {
        int id PK
        int paciente_id FK
        int especialidad_id FK
        datetime fecha_ingreso
        int prioridad
        string estado "En Espera, Ofrecido_Hold, Atendido, Expirado"
    }
    CITA {
        int id PK
        int paciente_id FK
        int medico_id FK
        int bloque_horario_id FK
        int tipo_consulta_id FK
        int solicitud_id FK
        int aseguradora_id FK
        string origen_cita "Web_Paciente, Interconsulta_Clinica, Asignacion_Admin"
        string motivo_cancelacion "Cancelado_Paciente, Imprevisto_Medico, Administrativo"
        string estado "Programada, Confirmada, En_Sala_Espera, En_Sala_Virtual, En_Atencion, Rezagado, Atendida, Cancelada, Reprogramada, No_Show"
    }
    HISTORIAL_REPROGRAMACION {
        int id PK
        int cita_id FK
        string motivo_cambio
        datetime fecha_transaccion
        string estado
    }
    TICKET_ASISTENCIA {
        int id PK
        int cita_id FK
        datetime fecha_generacion
        datetime hora_llegada
        int conteo_llamados "Max 2 antes de rezagado"
        string codigo_turno "Ej. T-042"
        string estado "Emitido, Primer_Llamado, Segundo_Llamado, Rezagado, Atendido, No_Show"
    }
    INTERCONSULTA {
        int id PK
        int paciente_id FK
        int medico_emisor_id FK
        int especialidad_destino_id FK
        text motivo_clinico
        date fecha_emision
        string estado "Aprobada, Utilizada, Vencida"
    }

