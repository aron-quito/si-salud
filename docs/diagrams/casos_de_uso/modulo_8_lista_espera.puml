@startuml
left to right direction

skinparam shadowing false
skinparam actor {
  BackgroundColor #F4F6F7
  BorderColor #2C3E50
  FontColor #2C3E50
}
skinparam usecase {
  BackgroundColor #EBF5FB
  BorderColor #2980B9
  FontColor #154360
  ArrowColor #2980B9
}
skinparam arrow {
  Color #34495E
  Thickness 1.5
}
skinparam package {
  BackgroundColor #FDEDEC
  BorderColor #C0392B
  FontColor #922B21
}


actor "Paciente" as Pac
actor "Admin" as Adm
actor "Sistema" as Sis

package "MÓDULO 8: Lista de espera y prioridades" {
  usecase "Ingresar a lista de espera" as UC1
  usecase "Clasificar por prioridad de urgencia" as UC2
  usecase "Asignar cupo con Hold Temporal (20 min)" as UC3
  usecase "Dar de baja solicitud de espera" as UC4
  usecase "Reasignar al siguiente tras expiración" as UC5
}

UC1 ..> UC2 : <<include>>
UC3 <.. UC5 : <<extend>>

Pac -[#27AE60]-> UC1

Sis -[#E74C3C]-> UC2
Sis -[#E74C3C]-> UC3
Sis -[#E74C3C]-> UC5

Adm -[#8E44AD]-> UC4
@enduml