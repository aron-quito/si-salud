@startuml
left to right direction

skinparam shadowing false
skinparam actor {
  BackgroundColor #F4F6F7
  BorderColor #2C3E50
  FontColor #2C3E50
}
skinparam usecase {
  BackgroundColor #EBF5FB
  BorderColor #2980B9
  FontColor #154360
  ArrowColor #2980B9
}
skinparam arrow {
  Color #34495E
  Thickness 1.5
}
skinparam package {
  BackgroundColor #FDEDEC
  BorderColor #C0392B
  FontColor #922B21
}


actor "Sistema" as Sis

package "MÓDULO 5: Motor de lógica de negocio" {
  usecase "Detectar banderas rojas (Emergencia Vital)" as UC1
  usecase "Asignar bloques elásticos contiguos" as UC2
  usecase "Validar edad y restricciones clínicas" as UC3
  usecase "Prevenir solapamiento de horarios (ACID)" as UC5
  usecase "Designar especialidad automáticamente (IA)" as UC6
  usecase "Derivar a Medicina General para interconsulta" as UC7
}

UC6 <.. UC7 : <<extend>>
UC2 ..> UC3 : <<include>>
UC2 ..> UC5 : <<include>>

Sis -[#E74C3C]-> UC1
Sis -[#E74C3C]-> UC2
Sis -[#E74C3C]-> UC6
Sis -[#E74C3C]-> UC7
@enduml