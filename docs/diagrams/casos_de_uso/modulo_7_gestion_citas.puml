@startuml
left to right direction

skinparam shadowing false
skinparam actor {
  BackgroundColor #F4F6F7
  BorderColor #2C3E50
  FontColor #2C3E50
}
skinparam usecase {
  BackgroundColor #EBF5FB
  BorderColor #2980B9
  FontColor #154360
  ArrowColor #2980B9
}
skinparam arrow {
  Color #34495E
  Thickness 1.5
}
skinparam package {
  BackgroundColor #FDEDEC
  BorderColor #C0392B
  FontColor #922B21
}


actor "Paciente" as Pac
actor "Recepción" as Rec
actor "Sistema" as Sis

package "MÓDULO 7: Gestión de citas" {
  usecase "Realizar formulario de triaje" as UC1
  usecase "Aceptar o rechazar horario propuesto (12h)" as UC8
  usecase "Generar ticket de turno" as UC2
  usecase "Confirmar asistencia (48h antes)" as UC3
  usecase "Cancelar la cita" as UC4
  usecase "Reprogramar la cita" as UC5
  usecase "Penalizar por límite de reprogramaciones" as UC6
  usecase "Registrar asistencia presencial (Admisión)" as UC7
  usecase "Check-in virtual en sala de espera (Meet/Llamada)" as UC9
}

UC5 <.. UC6 : <<extend>>
UC7 ..> UC2 : <<include>>

Pac -[#27AE60]-> UC1
Pac -[#27AE60]-> UC8
Pac -[#27AE60]-> UC3
Pac -[#27AE60]-> UC4
Pac -[#27AE60]-> UC5
Pac -[#27AE60]-> UC9

Sis -[#E74C3C]-> UC6

Rec -[#F1C40F]-> UC7
@enduml