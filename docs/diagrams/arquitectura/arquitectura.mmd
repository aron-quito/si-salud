        Alg[Algoritmo NLP / Urgencia]
    end

    subgraph Colas ["Procesamiento Asíncrono"]
        Redis[(Redis Cache)]
        BullMQ[[Cola de Tareas / BullMQ]]
        Cron((Cron Jobs Medianoche))
    end

