flowchart TD
    subgraph Frontend ["Cliente / Frontend (Next.js)"]
        UI_P[Portal Paciente]
        UI_M[Panel Médico]
        UI_A[Panel Administrativo]
        UI_R[Módulo Recepción/Caja]
    end

